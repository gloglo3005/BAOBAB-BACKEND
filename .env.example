# Copiez ce fichier en ".env" dans le dossier biblio, puis remplissez les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore).

# --- Obligatoire ---
# Clé secrète Django : longue, aléatoire, différente pour chaque environnement. Pour en générer une :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# True seulement en développement local. Laisser à False (ou absent) en production.
DEBUG=True

# --- Base de données : choisir UNE des deux options ---
# Option 1, locale (développement et tests) : PostgreSQL installé sur votre machine.
DB_NAME=baobab
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Option 2, hébergée (Neon) : si DATABASE_URL est définie, les variables DB_* sont ignorées.
# Pour lancer les tests, laissez-la absente : sinon ils tournent sur la base distante (très lent).
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# --- Interfaces web (CORS) ---
# Adresses des deux interfaces (administration et lecteurs), séparées par des virgules.
# En production, l'absence de cette variable bloque toutes les origines.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Noms de domaine supplémentaires autorisés, séparés par des virgules (facultatif).
EXTRA_ALLOWED_HOSTS=

# --- E-mails (Resend) ---
# Sans RESEND_API_KEY, les e-mails s'affichent dans la console (développement et tests).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Expéditeur : doit appartenir à un domaine vérifié chez Resend. En attendant, seul
# onboarding@resend.dev fonctionne, et uniquement vers l'adresse de votre compte Resend.
# DEFAULT_FROM_EMAIL=Baobab <no-reply@votre-domaine>

# --- Avancé (facultatif) ---
# Nombre de relais entre Internet et l'application, pour les limites de débit (1 par défaut sur Render).
# NUM_PROXIES=1
# Nom de la table de cache partagée entre plusieurs processus (api_cache par défaut sur Render).
# CACHE_TABLE=api_cache

# Ne PAS définir en local : RENDER et RENDER_EXTERNAL_HOSTNAME sont fournies par Render.
# Leur présence active la redirection HTTPS, les cookies sécurisés et le cache en base.
