/* Interface Staff : un outil de comptoir, lisible vite, sur ordinateur comme sur téléphone. */
:root {
  --ink: #15262b;
  --muted: #566a70;
  --paper: #f2f5f5;
  --surface: #ffffff;
  --line: #d3dcdd;
  --primary: #0f5e73;
  --primary-dark: #0a4757;
  --warn: #9a5200;
  --warn-bg: #fdf0d8;
  --bad: #a5281b;
  --bad-bg: #fbe4e1;
  --good: #1c6b43;
  --good-bg: #ddf1e5;
  --radius: 6px;
  --font: ui-sans-serif, system-ui, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, "Cascadia Mono", "SF Mono", Consolas, "Liberation Mono", monospace;
}

*, *::before, *::after { box-sizing: border-box; }
html { font-size: 17px; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font);
  line-height: 1.5;
}
a { color: var(--primary); }
a:hover { color: var(--primary-dark); }
:focus-visible { outline: 3px solid #e3a008; outline-offset: 2px; }

h1 { font-size: 1.75rem; line-height: 1.2; margin: 0 0 1rem; letter-spacing: -0.01em; }
h2 { font-size: 1.15rem; margin: 2rem 0 0.75rem; }
p { margin: 0 0 1rem; }

/* ---------- en-tête */
.topbar { background: var(--ink); color: #fff; }
.topbar-inner {
  max-width: 1100px; margin: 0 auto; padding: 0.6rem 1rem;
  display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
}
.brand { color: #fff; font-weight: 700; font-size: 1.1rem; text-decoration: none; }
.who { display: flex; align-items: center; gap: 1rem; font-size: 0.9rem; flex-wrap: wrap; }
.who a, .linklike { color: #d3e6da; }
.who-mail { color: #a9c3b3; }
.linklike {
  background: none; border: 0; padding: 0; font: inherit; cursor: pointer; text-decoration: underline;
}
.who form { margin: 0; }
.nav {
  max-width: 1100px; margin: 0 auto; padding: 0 1rem;
  display: flex; gap: 0.25rem; overflow-x: auto; -webkit-overflow-scrolling: touch;
}
.nav a {
  color: #d3e6da; text-decoration: none; padding: 0.7rem 0.9rem; white-space: nowrap;
  border-bottom: 3px solid transparent;
}
.nav a:hover { color: #fff; }
.nav a[aria-current="page"] { color: #fff; border-bottom-color: #e3a008; font-weight: 600; }

.page { max-width: 1100px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
.narrow { max-width: 520px; margin: 1.5rem auto 0; }

/* ---------- messages */
.messages { margin-bottom: 1rem; }
.msg { padding: 0.75rem 1rem; border-radius: var(--radius); border-left: 5px solid; margin: 0 0 0.5rem; background: var(--surface); }
.msg-success { border-color: var(--good); background: var(--good-bg); }
.msg-error { border-color: var(--bad); background: var(--bad-bg); }
.msg-warning { border-color: #e3a008; background: var(--warn-bg); }
.msg-info { border-color: var(--primary); }
.hint { color: var(--muted); }
.notice { background: var(--warn-bg); border-left: 5px solid #e3a008; padding: 0.6rem 1rem; border-radius: var(--radius); }
.muted { color: var(--muted); font-size: 0.9rem; }
.subtitle { color: var(--muted); margin-top: -0.5rem; }
.description { max-width: 70ch; }

/* ---------- boutons et champs */
.btn {
  display: inline-block; background: var(--primary); color: #fff; border: 0; border-radius: var(--radius);
  padding: 0.6rem 1.1rem; font: inherit; font-weight: 600; text-decoration: none; cursor: pointer;
  text-align: center;
}
.btn:hover { background: var(--primary-dark); color: #fff; }
.btn-secondary { background: var(--surface); color: var(--primary); box-shadow: inset 0 0 0 2px var(--primary); }
.btn-secondary:hover { background: #e3f0e8; color: var(--primary-dark); }
.btn-danger { background: var(--bad); }
.btn-danger:hover { background: #7f1d13; }
.btn-large { padding: 0.9rem 1.6rem; font-size: 1.1rem; }
.btn-small { padding: 0.3rem 0.7rem; font-size: 0.9rem; }

input[type="text"], input[type="search"], input[type="email"], input[type="password"], select, textarea {
  width: 100%; padding: 0.6rem 0.75rem; font: inherit; color: var(--ink);
  background: var(--surface); border: 2px solid var(--line); border-radius: var(--radius);
}
input:focus, select:focus, textarea:focus { border-color: var(--primary); }
label { display: block; font-weight: 600; margin-bottom: 0.35rem; }
label.inline { display: inline-flex; align-items: center; gap: 0.4rem; margin-right: 1.5rem; font-weight: 500; }
input[type="radio"] { width: 1.2rem; height: 1.2rem; accent-color: var(--primary); }
fieldset { border: 0; padding: 0; margin: 0; }
legend { font-weight: 600; margin-bottom: 0.4rem; padding: 0; }
.field { margin-bottom: 1rem; }
.field-error { color: var(--bad); margin: 0.25rem 0 0; }
.help { color: var(--muted); font-size: 0.9rem; margin-top: 0.25rem; }
.stack > * + * { margin-top: 1.25rem; }

/* Le champ de saisie du comptoir : grand, en chasse fixe, c'est lui qui reçoit le lecteur de codes. */
.scan { font-family: var(--mono); font-size: 1.25rem; padding: 0.8rem 1rem; border-color: var(--primary); }
.searchbar { display: flex; gap: 0.5rem; margin-bottom: 1.25rem; }
.searchbar .scan { flex: 1; }
.filters { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
.filters input { flex: 1 1 14rem; width: auto; }
.filters select { flex: 0 1 13rem; width: auto; }

.actions-row { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; margin: 1rem 0 1.5rem; }
.inline-form { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 0; }
.title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }

/* ---------- tableau de bord */
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0; margin: 0 0 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
.stat {
  display: flex; flex-direction: column-reverse; padding: 0.9rem 1rem; text-decoration: none; color: inherit;
  border-right: 1px solid var(--line);
}
.stat:last-child { border-right: 0; }
.stat dt { color: var(--muted); font-size: 0.9rem; }
.stat dd { margin: 0; font-size: 2rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.1; }
.stat-alert dd { color: var(--bad); }
a.stat:hover { background: #f3f7f1; }

/* ---------- listes de résultats et choix */
.rows { list-style: none; margin: 0 0 1rem; padding: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
.row { display: flex; align-items: center; gap: 1rem; padding: 0.7rem 1rem; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
.row:last-child { border-bottom: 0; }
.row-main { flex: 1 1 16rem; font-weight: 600; text-decoration: none; }
.row-meta { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; color: var(--muted); font-size: 0.9rem; }
.row-actions { margin-left: auto; }

.step { margin-bottom: 0; }
.choice {
  display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.9rem; font-weight: 400;
  background: var(--surface); border: 2px solid var(--line); border-radius: var(--radius);
  padding: 0.7rem 1rem; margin: 0.5rem 0 0; cursor: pointer;
}
.choice:has(input:checked) { border-color: var(--primary); background: #e6f2ea; }
.choice.is-disabled { background: #efede4; cursor: not-allowed; }
.choice-main { flex: 1 1 14rem; }
.choice-meta { display: flex; gap: 0.75rem; flex-wrap: wrap; color: var(--muted); font-size: 0.9rem; }
.choice-button { width: 100%; text-align: left; font: inherit; }
.choice-button:hover { border-color: var(--primary); }

/* ---------- tableaux */
.table-wrap { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
.table { width: 100%; border-collapse: collapse; }
.table th, .table td { padding: 0.65rem 0.9rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
.table th { font-size: 0.9rem; color: var(--muted); font-weight: 600; background: #f4f6ee; white-space: nowrap; }
.table tr:last-child td { border-bottom: 0; }
.pagination { display: flex; gap: 1rem; align-items: center; justify-content: center; margin-top: 1rem; color: var(--muted); }

/* ---------- étiquettes d'état */
.code { font-family: var(--mono); font-size: 0.9em; background: #ebe8dc; padding: 0.1rem 0.4rem; border-radius: 4px; white-space: nowrap; }
.badge { display: inline-block; font-size: 0.85rem; font-weight: 600; padding: 0.1rem 0.55rem; border-radius: 999px; background: #ebe8dc; color: var(--ink); white-space: nowrap; }
.s-available, .s-returned, .s-accepted { background: var(--good-bg); color: var(--good); }
.s-borrowed, .s-active, .s-pending, .s-suspended { background: var(--warn-bg); color: var(--warn); }
.s-lost, .s-damaged, .s-rejected, .s-overdue { background: var(--bad-bg); color: var(--bad); }
.s-unavailable { background: #ebe8dc; color: var(--muted); }

/* ---------- fiches et reçu */
.facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.75rem 1.5rem; margin: 0 0 1rem; }
.facts dt { color: var(--muted); font-size: 0.9rem; }
.facts dd { margin: 0; font-weight: 600; }
.receipt { max-width: 640px; margin: 0 auto; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; }
.receipt-due { font-size: 1.3rem; }

@media (max-width: 640px) {
  html { font-size: 16px; }
  .stat { border-right: 0; border-bottom: 1px solid var(--line); }
  .stat:last-child { border-bottom: 0; }
  .searchbar { flex-direction: column; }
  .btn-large { width: 100%; }
  .actions-row .btn { flex: 1 1 100%; }
}
@media print {
  .topbar, .no-print, .messages { display: none !important; }
  body { background: #fff; }
  .receipt { border: 0; }
}

/* ---------- gestion du catalogue */
textarea { min-height: 5rem; resize: vertical; }
textarea.mono { font-family: var(--mono); }
.narrow.wide { max-width: 760px; }
.form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0 1.25rem; }
.panel { border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1rem 0.25rem; background: var(--surface); }
.panel legend { padding: 0 0.4rem; }
.two-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 1.5rem 2.5rem; align-items: start; }
.actions-row.tight { margin: 0; }
.nowrap { white-space: nowrap; }
.add-form { margin-bottom: 0.75rem; }
.add-form input { flex: 1; }
.inline-form.grow { flex: 1 1 18rem; flex-wrap: nowrap; align-items: center; }
.inline-form.grow input { flex: 1; min-width: 6rem; }
.row.is-off { background: #f3f1e8; }

